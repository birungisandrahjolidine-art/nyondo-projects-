doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sales Registration
    link(rel='stylesheet' href='/css/sales.css')

  body
    .container
      h2 Register New Sale

      form(action="/salesform" method="post" novalidate)
        .row
          .input-box
            label Customer Name
            input(type='text' name='customerName' required)

        .row
          .input-box
            label Customer Address
            input(type='text' name='customerAddress' required)

          .input-box
            label Customer Distance (KM)
            input(type='number' name='customerDistance' required)

        
        .row
          .input-box
            label Phone Number
            input(
              type='text'
              name='phoneNumber'
              placeholder='+256700123456'
              pattern='^\\+256[0-9]{9}$'
              title='Phone number must start with +256 and contain exactly 9 digits after it'
              required=""
            )
        h3 Items Purchased

        #itemsContainer

          .item-row
            .input-box
              label Item
              select(name='items[0][itemId]' required)
                option(value='') Select Item
                each item in stockItems
                  option(value=item._id)
                    = item.itemName + " (Stock: " + item.quantity + ")"

            .input-box
              label Quantity
              input(type='number' name='items[0][quantity]' required)

        button(type='button' onclick='addItem()') + Add Another Item
        .row
          .input-box
            label Transport Type
            select(name='transportType' required)
              option(value='') Select Transport Option
              option(value='own') Use Own Transport (No Charge)
              option(value='hardware') Hardware Provides (Free if Purchase ≥ 500,000 UGX)
              option(value='paid') Pay 30,000 UGX for Hardware Transport
        .row
          .input-box
            label Payment Method
            select(name='paymentMethod' required)
              option(value='') Select Payment Method
              option(value='cash') Cash
              option(value='mobile') Mobile Money
              option(value='bank') Bank

        button(type='submit') Submit Sale
//- javascript validations
script.
  const form = document.querySelector('form');

  form.addEventListener('submit', function (e) {
    let isValid = true;

    const fields = form.querySelectorAll('[required]');

    fields.forEach(field => {
      const box = field.closest('.input-box') || field.parentElement;

      let error = box.querySelector('.error-text');

      if (!error) {
        error = document.createElement('small');
        error.classList.add('error-text');
        box.appendChild(error);
      }

      let value = field.value;

      // Handle number fields
      if (field.type === 'number') {
        if (value === '' || isNaN(value)) {
          isValid = false;
          showError();
          return;
        }
      }

      // Handle select + text
      if (!value || value === '') {
        isValid = false;
        showError();
        return;
      }

      clearError();

      function showError() {
        box.classList.add('error');
        error.innerText = 'This field is required';
      }

      function clearError() {
        box.classList.remove('error');
        error.innerText = '';
      }
    });

    if (!isValid) {
      e.preventDefault();
    }
  });