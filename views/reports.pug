doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Monthly Business Performance Report
    link(rel="stylesheet", href="/css/reports.css") 
  body
    .dashboard-container

      // Combined Top Action and Filter Row
      .report-action-bar
        a.back-btn(href='/admin') ← Back to Dashboard
        
        //- form.search-form(method="get", action="/jolidine/reports")
        //-   label Select Month:
        //-   select(name="range")
        //-     option(value="month") This Month
        //-     option(value="lastMonth") Last Month
        //-     option(value="week") This Week
        //-     option(value="lastWeek") Last Week
        //-   button(type="submit" class="search-submit-btn") 🔍 Search
          
        button.print-btn(onclick='window.print()') 🖨 Print Report

      // Header Section
      header.dashboard-header
        .header-title
          h1 #{reportTitle} PERFORMANCE REPORT
        .header-logo
          span.logo-text NYONDO Hardware LTD

      // Top Summary Metrics Cards
      section.metrics-grid
        .metric-card
          h3 TOTAL REVENUE (Cash + Credit)
          p.metric-value UGX #{(totalRevenue || 0).toLocaleString()}
        .metric-card
          h3 TOTAL EXPENSES (Stock + Transport)
          p.metric-value UGX #{(totalExpenses || 0).toLocaleString()}
        .metric-card
          h3 NET CASH FLOW
          p.metric-value(class=(netCashFlow || 0) >= 0 ? 'positive' : 'negative') UGX #{(netCashFlow || 0).toLocaleString()}
        .metric-card
          h3 OWE TO SUPPLIERS (Factory Credit)
          p.metric-value.negative UGX #{(totalSupplierCredit || 0).toLocaleString()}

      // Data Tables Grid
      main.data-grid
        
        // 1. Sales & Customer Credit Table
        .data-card
          h2 Sales & Payments Log
          .table-container
            table
              thead
                tr
                  th Customer Name
                  th Payment Method
                  th Transport Charge
                  th Total Charged
              tbody
                each sale in dbSales
                  tr
                    td #{sale.customerName || 'Walk-in Buyer'}
                    td 
                      if sale.paymentMethod === 'Credit' || sale.isSalaryScheme
                        span.badge.overdue #{sale.paymentMethod}
                      else
                        span.badge.active #{sale.paymentMethod || 'Cash'}
                    td UGX #{sale.transportCharge.toLocaleString()}
                    td UGX #{sale.totalCharge.toLocaleString()}
                if dbSales.length === 0
                  tr
                    td(colspan="4") No sales records found for this month.

        // 2. Stock Added Table
        .data-card
          h2 Stock Added & Vendor Balances
          .table-container
            table
              thead
                tr
                  th Item Name
                  th Qty Registered
                  th Unit Price
                  th Total Value
              tbody
                each item in stockItems
                  tr
                    td #{item.itemName}
                    td #{item.quantity} units
                    td UGX #{(item.unitPrice || 0).toLocaleString()}
                    td UGX #{(item.quantity * (item.unitPrice || 0)).toLocaleString()}
                if stockItems.length === 0
                  tr
                    td(colspan="4") No stock replenishment registered this month.

        // 3. Creditors Table
        .data-card
          h2 Creditors Item Details
          .table-container
            table
              thead
                tr
                  th Customer Name
                  th Phone
                  th Item
                  th Quantity
                  th Amount
                  th Date
              tbody
               each c in creditors
                  tr
                      td #{c.customerName}
                      td #{c.phone || 'N/A'}
                      td #{c.itemName}
                      td #{c.quantity}
                      td UGX #{(c.totalCost || 0).toLocaleString()}
                      td #{new Date(c.date).toDateString()}
                  if creditors.length === 0
                    tr
                      td(colspan="6") No credit sales found for this period.
          